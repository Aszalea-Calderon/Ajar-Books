# Drizzle (used by drizzle-kit for local dev only — the Docker image sets its own DATABASE_URL)
DATABASE_URL=local.db

# Required: random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional (Docker only): the origin SvelteKit should trust for form submissions.
# Defaults to http://localhost:3000 — override if you're serving from a different
# host/port, a LAN address, or a domain/tunnel.
ORIGIN=

# Optional: enables Google Books as a metadata source for better cover art/coverage
GOOGLE_BOOKS_API_KEY=

# Optional: point at an existing Ollama instance to enable AI-enhanced reader-type phrasing
OLLAMA_URL=

# Optional: set to "true" once serving over HTTPS (reverse proxy/Cloudflare Tunnel) to mark
# session cookies Secure. Leave unset for plain http://localhost access.
SECURE_COOKIES=

# Optional (Docker only): max request body size. Defaults to 8M in docker-compose.yml,
# large enough for a real photo upload (Settings > Data > Profile Icon) — only override
# if you need something different.
BODY_SIZE_LIMIT=
